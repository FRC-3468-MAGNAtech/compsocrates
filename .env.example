FTC_API_USERNAME=
FTC_API_KEY=

# Firebase web config isn't secret (security comes from firestore.rules), but
# Next.js only exposes env vars to the browser bundle with this prefix.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# P7: Firebase Cloud Messaging web push key pair. Firebase Console > Project
# Settings > Cloud Messaging > Web Push certificates > Generate key pair.
# Not secret (same reasoning as the rest of the client config above) but
# still only exposed with the NEXT_PUBLIC_ prefix by convention with the
# others. See docs/DEPLOYMENT.md.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK (server-only — never prefix with NEXT_PUBLIC_). From a
# service account JSON: Firebase Console > Project Settings > Service
# Accounts > Generate new private key. See docs/DEPLOYMENT.md for how to
# paste the private key into Vercel's env var UI.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# P7: required by app/api/cron/poll-live-scores — the job's own request must
# send this as `Authorization: Bearer <CRON_SECRET>`, so nothing else can
# trigger it. Generate with e.g. `openssl rand -hex 32`. See
# docs/DEPLOYMENT.md for how to schedule calls to that route.
CRON_SECRET=

# Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser).
# Comma-separated, compared case-insensitively. These are PLATFORM owners (P20):
# synced to the isPlatformOwner flag + the platformOwner/admin custom claims by
# app/api/auth/sync-roles on every login — only after the signing-in email is
# verified. See docs/ASSUMPTIONS.md (P1b, P20).
OWNER_EMAILS=

# P20: platform owners are the emails in OWNER_EMAILS above (they approve team applications and can recover accounts).
# Team ownership is separate (teams/{teamId}.ownerUid) and transferable in the app.

# P20: Cloudflare Turnstile (CAPTCHA on team applications). Set both or neither. See docs/DEPLOYMENT.md section 9.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only.
TURNSTILE_SECRET_KEY=

# P20: outbound email via Resend (optional). Server-only. APP_URL is used for links in emails.
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=

# P20: optional. Signs the application form's start token and keys the stored IP/email hashes (any long random string).
# Derived from FIREBASE_ADMIN_PRIVATE_KEY when unset.
APPLICATION_SECRET=

# Photo uploads (form image field): from the Vercel dashboard > Storage > Blob store (see docs/DEPLOYMENT.md section 13). Server-only; never commit a value.
BLOB_READ_WRITE_TOKEN=

# Event data providers (config/event.ts). All server-only: never prefix with NEXT_PUBLIC_.
# Default program is FRC. Set EVENT_PROGRAM=ftc (and NEXT_PUBLIC_EVENT_PROGRAM=ftc so the browser
# helpers agree) to run CE's FTC provider instead; then FTC_API_USERNAME / FTC_API_KEY above apply.
EVENT_PROGRAM=
NEXT_PUBLIC_EVENT_PROGRAM=
# The Blue Alliance v3 read key (one server key; events, teams, matches, rankings).
TBA_API_KEY=
# FIRST FRC API v3.0 (practice schedule, and fallback for teams, rankings and qualification matches).
FIRST_API_USERNAME=
FIRST_API_TOKEN=

# CS adapter (docs/ROUTES.md D1): uids of the platform owner(s), comma separated. Replaces the uid hard-coded in CS's Firestore rules.
# The NEXT_PUBLIC_ one drives the UI; CS_OWNER_UIDS is the server-side fallback.
NEXT_PUBLIC_CS_OWNER_UIDS=
CS_OWNER_UIDS=
