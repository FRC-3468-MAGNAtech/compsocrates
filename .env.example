# Copy this file to .env.local and fill it in. Placeholders only: never commit real values.
# docs/ENVIRONMENT.md explains every variable, what breaks without it and which outside services the app calls.
# Admin Panel > Setup Check lists what is still missing (names only, never values).
# The variable names here are checked against ENV_VARS in lib/server/env.ts by a unit test.
# [secret] = grants access if leaked: keep it out of git and mark it "sensitive" in the host.
# [config] = not sensitive (public by design, or just an identifier): it still differs per deployment, so it lives here.

# ---------------------------------------------------------------------------
# (A) CompSocrates (same names as the CompSocrates app)
# ---------------------------------------------------------------------------

# [config] Firebase web config. Not secret (security comes from the Firestore rules); the NEXT_PUBLIC_ prefix is what lets
# the browser see it. Firebase Console > Project Settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# [secret] The Blue Alliance read key (https://www.thebluealliance.com/account > Read API Keys).
# Read on the server only: no browser code references it, so it is never shipped to the browser.
NEXT_PUBLIC_TBA_API_KEY=

# [secret] FIRST FRC Events API v3.0 credentials (practice schedules, and the fallback for teams, rankings and qualification matches).
FIRST_API_USERNAME=
FIRST_API_TOKEN=

# [config] Platform owner(s): comma-separated Firebase uids, and/or comma-separated verified emails. One of the two is enough.
# (The uids are identifiers. The emails are personal data: keep them out of any committed file.)
# The server reads these. (NEXT_PUBLIC_RELEASE_OWNER_UIDS in section C is an optional browser copy.)
RELEASE_OWNER_UIDS=
RELEASE_OWNER_EMAILS=

# ---------------------------------------------------------------------------
# (B) Required by the rebuild's server routes
# ---------------------------------------------------------------------------

# Firebase Admin service account (server only, never prefix with NEXT_PUBLIC_). Firebase Console > Project Settings >
# Service Accounts > Generate new private key, then copy the three fields from the downloaded JSON.
# Without these, server sign-in checks cannot run: event data, team join approvals, role sync and account deletion all
# answer "Server sign-in is not configured".
# [config] The project id is public (the same value as NEXT_PUBLIC_FIREBASE_PROJECT_ID).
FIREBASE_ADMIN_PROJECT_ID=
# [config] An identifier, useless without the key below.
FIREBASE_ADMIN_CLIENT_EMAIL=
# [secret] Full admin access to the project (it bypasses the Firestore rules). Paste the whole private key on ONE line, with each line break written as the two characters \n (backslash, n), exactly as it
# appears in the JSON file. Do not add real line breaks and do not wrap the value in quotes (a dashboard's own quotes are fine,
# a literal quote inside the value is not).
FIREBASE_ADMIN_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# (C) Optional (the feature is off when unset)
# ---------------------------------------------------------------------------

# [config] Public URL of the site, used for links inside emails. Falls back to the host's own URL variables.
APP_URL=
# [secret] Protects /api/cron/poll-live-scores: the scheduler sends it as "Authorization: Bearer <CRON_SECRET>". Unset means the
# poller refuses to run. Generate one with: openssl rand -hex 32
CRON_SECRET=
# Notification email through Resend. Both are needed; without them no email is sent and the app still works.
# [secret]
RESEND_API_KEY=
# [config] A sender address on a domain you verified in Resend.
EMAIL_FROM=
# Cloudflare Turnstile bot check on team applications. Set both or neither; unset skips the check.
# [config] Public by design: it is embedded in the page.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# [secret]
TURNSTILE_SECRET_KEY=
# [secret] Vercel Blob storage for photo uploads (Vercel dashboard > Storage > Blob). Unset turns photo uploads off.
BLOB_READ_WRITE_TOKEN=
# [config] Firebase Cloud Messaging web push key (Project Settings > Cloud Messaging > Web Push certificates). The public half of the
# key pair, shipped to the browser. Unset turns push off.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# [secret] Signs team-application tokens (any long random string). Derived from FIREBASE_ADMIN_PRIVATE_KEY when unset.
APPLICATION_SECRET=
# [config] Optional browser copy of RELEASE_OWNER_UIDS (the server reads RELEASE_OWNER_UIDS; this one only lets the UI know who the owner is).
NEXT_PUBLIC_RELEASE_OWNER_UIDS=

# ---------------------------------------------------------------------------
# Intentionally absent
# ---------------------------------------------------------------------------
# The CompSocrates app also has a shared login (MIGRATION_EMAIL / MIGRATION_PASSWORD) and TBA_KEY_ENCRYPTION_SECRET for
# per-team encrypted TBA keys. This app signs everyone in with their own account and uses the one TBA key above, so
# neither is read here. Leaving them out is correct.
